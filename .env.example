# Copie para .env e preencha. NUNCA versione o .env.
# Gere valores com: node scripts/gerar-chaves.mjs

# Banco (Render/Neon fornecem DATABASE_URL no formato postgres://usuario:senha@host/banco)
# DATABASE_URL=
# ou: ConnectionStrings__Postgres=Host=localhost;Database=alerta;Username=postgres;Password=postgres

# Segredo das centrais simuladas (HMAC) e chave de cifragem de dados sensíveis (32 bytes em base64)
Centrais__SegredoMestre=
Dados__ChaveCifragem=

# IA (opcional). Provedor: anthropic | openai (qualquer API compatível com /chat/completions)
IA__Provedor=
IA__ChaveApi=
IA__Modelo=
# IA__UrlBase=

# Web Push (opcional). Chaves VAPID P-256 em base64url
WebPush__ChavePublica=
WebPush__ChavePrivada=
WebPush__Assunto=mailto:seu-email@exemplo.com

# Modo demonstração (contas fictícias e atalhos)
Demo__Habilitado=true
